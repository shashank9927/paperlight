{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/",
      "permanent": true
    },
    {
      "source": "/tools/merge",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/merge",
      "permanent": true
    },
    {
      "source": "/tools/split",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/split",
      "permanent": true
    },
    {
      "source": "/tools/compress",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/compress",
      "permanent": true
    },
    {
      "source": "/tools/organize",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/organize",
      "permanent": true
    },
    {
      "source": "/tools/rotate",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/rotate",
      "permanent": true
    },
    {
      "source": "/tools/images-to-pdf",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/images-to-pdf",
      "permanent": true
    },
    {
      "source": "/tools/pdf-to-images",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/pdf-to-images",
      "permanent": true
    },
    {
      "source": "/tools/watermark",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/watermark",
      "permanent": true
    },
    {
      "source": "/tools/page-numbers",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/page-numbers",
      "permanent": true
    },
    {
      "source": "/tools/protect",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/protect",
      "permanent": true
    },
    {
      "source": "/tools/unlock",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/unlock",
      "permanent": true
    },
    {
      "source": "/tools/sign",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/tools/sign",
      "permanent": true
    },
    {
      "source": "/alternatives/ilovepdf",
      "has": [
        {
          "type": "host",
          "value": "paperlight-kappa.vercel.app"
        }
      ],
      "destination": "https://pdf.havisu.com/alternatives/ilovepdf",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/:tool/index.html",
      "destination": "/tools/:tool",
      "permanent": true
    },
    {
      "source": "/alternatives/ilovepdf/index.html",
      "destination": "/alternatives/ilovepdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self' blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/tools/:tool",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/install-capture.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pdf-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/alternatives/:page",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
